# Copia a p6.env y ajusta. P6_TOKEN debe ser igual a P6_BRIDGE_TOKEN de backend/.env
#   Docker junto al backend (docker compose):  http://backend:3050
#   Raspberry Pi en la red:                     http://<IP-de-la-PC-con-el-backend>:3065
P6_SERVER_URL=http://backend:3050
P6_SOCKET_PATH=socket.io
P6_TOKEN=
P6_DEVICE_MATCH=P-6
P6_MIDI_CHANNEL=11
P6_RECONNECT_SECONDS=5
# 1 = sin P-6 solo escribe en el log lo que tocaría (útil en Docker sobre Windows)
P6_DRY_RUN=0
LOG_LEVEL=INFO
