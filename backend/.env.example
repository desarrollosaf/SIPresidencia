# Plantilla de configuracion. Copiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env
# El archivo .env no se versiona: trae las credenciales del servidor.

PORT=3050

# ---------------------------------------------------------------------
# Base de datos propia de SIPresidencia.
#
# DB_HOST segun donde este el servidor:
#   mysql                   usas "docker compose up" con el servicio mysql que trae este repo
#   host.docker.internal    MySQL en esta misma maquina (fuera de Docker) y el backend en Docker
#   localhost                MySQL en esta misma maquina y el backend con npm
#   10.0.0.25 / mysql.interno   servidor de red (pon su IP o su nombre)
#
# Si usas el "docker compose up" de este repo tal cual (con su servicio
# mysql), estos 4 valores ya funcionan sin cambiarles nada:
# ---------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=sipresidencia
DB_DATABASE=sipresidencia

# Secreto de firma del token. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# ---------------------------------------------------------------------
# API de SIRegistroParlamentario. SIPresidencia solo lee de ahi (eventos,
# orden del dia, votos, video de cada punto) - no duplica esos datos.
#   https://parlamentario.congresoedomex.gob.mx/backend   servidor real (default; la API vive bajo /backend, no en la raiz)
#   http://host.docker.internal:3013                        SIRegistroParlamentario en el host y el backend en Docker
#   http://localhost:3013                                    SIRegistroParlamentario en el host y el backend con npm
# ---------------------------------------------------------------------
REGISTRO_API_URL=https://parlamentario.congresoedomex.gob.mx/backend
REGISTRO_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Roland P-6. El puente de Python (p6-bridge/, en la Raspberry Pi o en
# Docker) se conecta por Socket.IO a este backend y debe mandar la misma
# clave en su variable P6_TOKEN. Generala con: openssl rand -hex 24
# ---------------------------------------------------------------------
P6_BRIDGE_TOKEN=
P6_ACK_TIMEOUT_MS=3000

# ---------------------------------------------------------------------
# App SPID → botón "Notificar al congreso" (POST /spid/p6/notificar).
# La app manda su token de SPID; aquí se valida contra SPID_API_URL/api/user/me
# y solo pasa quien preside la Junta de Coordinación Política (se consulta en SPID).
# El pad lo decide el servidor; la app no puede elegir otro.
# ---------------------------------------------------------------------
SPID_API_URL=https://parlamentario.congresoedomex.gob.mx
SPID_P6_BANK=A
SPID_P6_PAD=1
SPID_P6_ESPERA_SEGUNDOS=10

# ---------------------------------------------------------------------
# Vista "Notificar": avisos al equipo por Pushover. Suenan en el iPhone
# aunque esté en silencio (alerta crítica). Cada aviso suena 2 veces: al momento y
# PUSHOVER_REPETIR_SEGUNDOS después (0 = solo una), sin confirmar. Las personas se dan de alta en "Equipo de trabajo"
# con el User Key que les da la app de Pushover y su equipo (encargado).
#   PUSHOVER_TOKEN   token de la aplicación: https://pushover.net/apps/build
#   PUSHOVER_SONIDO  vibrate (solo vibra), persistent (largo), siren...
#                    lista: https://pushover.net/api#sounds
# ---------------------------------------------------------------------
PUSHOVER_TOKEN=
PUSHOVER_SONIDO=persistent
PUSHOVER_REPETIR_SEGUNDOS=5
PUSHOVER_ESPERA_SEGUNDOS=30

# /tableta abre "Llamar" SIN iniciar sesión (solo llamar y detener; no agregar/quitar
# personas ni ver sus claves). Vacía = cualquiera que conozca la dirección puede usarla.
# Para cerrarla con llave, ponle un valor (openssl rand -hex 24) y comparte el enlace:
#   https://<dominio>/tableta?llave=<TABLETA_LLAVE>
TABLETA_LLAVE=
